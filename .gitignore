# Aegis Monorepo Git Ignore

# Local Environment Variables
.env

# Go Build Artifacts
aegis-proxy.exe
aegis-proxy
proxy-engine/aegis-proxy
proxy-engine/aegis-proxy.exe
*.exe
*.exe~
*.dll
*.so
*.dylib

# Python Virtual Environments
venv/
.venv/
ENV/
env/
v/
ipython_log.py

# Python Cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Python Build Artifacts
dist/
build/
*.egg-info/

# Logs
*.log
*.log.*
logs/
.system_generated/

# Database Files
*.db
*.sqlite

# IDE and Editor Configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# Private Internal Documentation
.env
INTERNAL_NOTES.md
*.private.md

# Graphify Knowledge Graph (local tool cache — regenerate with `graphify update .`)
# Indexed per-sub-repo, because the workspace-root .gitignore excludes this
# directory and makes its source invisible to a root-level index.
graphify-out/
.graphify_ast.json
